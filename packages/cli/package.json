{
  "name": "schelf",
  "version": "0.5.1",
  "description": "Install apps and command-line tools, and publish your own on schelf.store",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lantharos/Store.git",
    "directory": "packages/cli"
  },
  "homepage": "https://schelf.store/docs/cli",
  "bin": {
    "schelf": "dist/schelf.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=esm --minify --outfile=dist/schelf.js",
    "check": "tsc -p .",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@schelf/program": "workspace:*",
    "@types/bun": "1.4.4"
  }
}
