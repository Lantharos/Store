{
  "name": "schelf",
  "version": "0.1.4",
  "description": "Publish apps and Luft extensions on schelf.store",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lantharos/Store.git",
    "directory": "packages/cli"
  },
  "homepage": "https://schelf.store/docs",
  "bin": {
    "schelf": "dist/schelf.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=esm --minify --outfile=dist/schelf.js",
    "check": "tsc -p .",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@schelf/appstream": "workspace:*",
    "@schelf/protocol": "workspace:*",
    "@schelf/publisher": "workspace:*",
    "@types/bun": "1.4.4",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  }
}
