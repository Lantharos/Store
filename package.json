{
  "name": "schelf-store",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter @schelf/api --filter @schelf/web dev",
    "check": "bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "7.0.2"
  }
}
