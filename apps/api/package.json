{
  "name": "@schelf/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pult build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "types": "wrangler types --env-file .dev.vars.example",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "seed": "bun scripts/seed.ts",
    "check": "tsc -p . && tsc -p test",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.15",
    "@cf-wasm/resvg": "0.4.0",
    "@lantharos/pult": "0.12.0",
    "@schelf/protocol": "workspace:*",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "postal-mime": "4.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "drizzle-kit": "0.31.11",
    "vitest": "5.1.0",
    "wrangler": "4.156.2"
  }
}
