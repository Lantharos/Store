      "triage": {
        "instructions": "Each item is a release of a desktop app submitted to schelf.store, an app store for Linux, Windows and macOS. It shows the store's checks, the files, the declared permissions, the listing and, for updates, a digest of the source changes. Judge the submission itself; a person makes every decision that isn't obvious junk.",
        "questions": {
          "junk": {
            "type": "noul",
            "prompt": "Is this an empty, broken, placeholder or spam submission?"
          },
          "kind": {
            "type": "choice",
            "prompt": "What is this submission?",
            "options": {
              "genuine": "A real app doing what its listing says",
              "copycat": "A copy of another app, or passing itself off as one",
              "malware": "Looks built to harm or deceive the people who install it",
              "incomplete": "A real app whose listing isn't finished"
            }
          },
          "quality": {
            "type": "score",
            "prompt": "How finished does the listing look: name, summary, description, icon, screenshots?",
            "levels": [
              "low",
              "fair",
              "good"
            ]
          }
        },
        "rules": [
          {
            "name": "Close junk",
            "live": false,
            "then": [
              {
                "type": "run",
                "action": "release.reject",
                "input": {
                  "reason": "This submission is empty, broken, a placeholder or spam, so it wasn't reviewed further. This was decided automatically; reply to this email if you think it's wrong and a person will look again."
                }
              }
            ]
          },
          {
            "name": "Flag malware suspects",
            "live": false,
            "then": [
              {
                "type": "tag",
                "tag": "malware"
              }
            ]
          },
          {
            "name": "Flag copycats",
            "live": false,
            "then": [
              {
                "type": "tag",
                "tag": "impersonation"
              }
            ]
          },
          {
            "name": "Ask for a finished listing",
            "live": false,
            "then": [
              {
                "type": "run",
                "action": "release.requestChanges",
                "input": {
                  "message": "The listing needs more before it can be reviewed: a clear name and summary, a description, an icon, at least two screenshots per system and a category. The release page shows what's missing."
                }
              }
            ]
          }
        ]
      },
      "reply": false,
      "hooks": {
        "state": false
      },
